### POS System API Testing File
### Base URL
@baseUrl = http://localhost:8081/api

### ==================== CATEGORY ENDPOINTS ====================

### Create Category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic devices and accessories"
}

### Get All Categories
GET {{baseUrl}}/categories

### Get Category by ID
GET {{baseUrl}}/categories/1

### Update Category
PUT {{baseUrl}}/categories/1
Content-Type: application/json

{
  "name": "Electronics Updated",
  "description": "Updated description"
}

### Delete Category
DELETE {{baseUrl}}/categories/1

---

### ==================== PRODUCT ENDPOINTS ====================

### Create Product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Laptop Dell XPS 13",
  "sku": "DELL-XPS-13",
  "price": 999.99,
  "costPrice": 600.00,
  "quantity": 50,
  "category": {
    "id": 1
  },
  "unit": "PCS",
  "description": "Premium ultrabook laptop"
}

### Get All Products
GET {{baseUrl}}/products

### Get Product by ID
GET {{baseUrl}}/products/1

### Update Product
PUT {{baseUrl}}/products/1
Content-Type: application/json

{
  "name": "Laptop Dell XPS 13 - Updated",
  "price": 1099.99,
  "quantity": 45
}

### Delete Product
DELETE {{baseUrl}}/products/1

---

### ==================== CUSTOMER ENDPOINTS ====================

### Create Customer
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "name": "Nguyen Van A",
  "phone": "0987654321",
  "email": "nguyenvana@email.com",
  "address": "123 Main Street, Hanoi",
  "membershipTier": "Gold",
  "points": 0.0,
  "totalSpent": 0.0
}

### Get All Customers
GET {{baseUrl}}/customers

### Get Customer by ID
GET {{baseUrl}}/customers/1

### Update Customer
PUT {{baseUrl}}/customers/1
Content-Type: application/json

{
  "name": "Nguyen Van A Updated",
  "phone": "0987654322",
  "membershipTier": "Platinum",
  "points": 100.0,
  "totalSpent": 5000.00
}

### Delete Customer
DELETE {{baseUrl}}/customers/1

